# Copy to .env and fill in. Never commit .env.
ESPN_LEAGUE_ID=123456
ESPN_YEAR=2026
# Only needed for private leagues. Find both in your browser cookies on fantasy.espn.com.
ESPN_S2=
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
# Your team's name exactly as ESPN shows it (partial matches work if unique).
MY_TEAM=
# Only needed for --explain. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
